# Copy to .env and fill in. .env is gitignored and must stay that way.

# AgentSwitch platform — same email, one password per business.
# Posted in your own team channel and nowhere else.
AS_EMAIL=team18@theschoolofai.in
AS_PASSWORD_SURYODAYA=
AS_PASSWORD_KEYSTONE=

# The agent's own model loop. The platform holds no operator key:
# you run your agent on your own machine with your own keys.
ANTHROPIC_API_KEY=

# Safety interlock. Never set in CI. Required for --mode live.
# AS_ALLOW_SEND=1
